# Copier en deploy/.env. Aucune valeur secrète ici : les clés vivent dans le volume de données (/data/keys).
VP_PORT=8443
VP_LOG_LEVEL=info
# Marge de péremption (Q-03) : un lot est invendable s'il périme avant aujourd'hui + N jours.
VP_EXPIRY_BLOCK_DAYS=0
# Jamais false en production (I-05).
VP_REQUIRE_TLS=true
