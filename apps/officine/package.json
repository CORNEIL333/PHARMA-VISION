{
  "name": "@visionpharma/officine",
  "version": "0.1.0",
  "private": true,
  "description": "VisionPharma Officine — gestionnaire d'officine hors ligne (nœud local)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"Aucun test de bout en bout pour l'instant (interface non construite)\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "init": "tsx scripts/init.ts",
    "start": "tsx server/src/main.ts",
    "start:prod": "node dist/server/src/main.js",
    "verify-ledger": "tsx scripts/verify-ledger.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
