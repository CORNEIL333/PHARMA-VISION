{
  "name": "@visionpharma/officine",
  "version": "0.1.0",
  "private": true,
  "description": "VisionPharma Officine — gestionnaire d'officine hors ligne (nœud local)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix web run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm --prefix web run build && npm --prefix web run test:e2e",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && npm --prefix web run build",
    "init": "tsx scripts/init.ts",
    "start": "tsx server/src/main.ts",
    "start:prod": "node dist/server/src/main.js",
    "import-catalog": "tsx scripts/import-catalog.ts",
    "verify-ledger": "tsx scripts/verify-ledger.ts",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "publish-desktop": "tsx scripts/publish-desktop.ts",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:test": "cd desktop/src-tauri && cargo test",
    "desktop:pinning-test": "node scripts/desktop-pinning-test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@sinclair/typebox": "0.34.52",
    "@visionpharma/protocol": "file:../../packages/protocol",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
